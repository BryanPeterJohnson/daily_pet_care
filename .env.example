# ── Database (Hostinger hPanel → Databases → MySQL Databases) ──
# On the Hostinger server itself the host is usually "localhost".
# For local development, enable Remote MySQL in hPanel and use the server's hostname/IP.
DATABASE_URL="mysql://u123456789_petuser:YOUR_PASSWORD@localhost:3306/u123456789_petblog"

# ── Auth ── generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# ── Public site URL (no trailing slash) — used for SEO, sitemap, RSS, OG tags ──
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# ── First admin account (used only by `npm run db:seed`) ──
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Site Admin"

# ── Uploads folder (absolute path recommended on Hostinger so files survive redeploys) ──
# e.g. /home/u123456789/petblog-uploads
UPLOAD_DIR="./uploads"
